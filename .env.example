# Copy to `.env.local` for local work. Both values are public by design — they
# are compiled into the JavaScript that every visitor downloads.
#
# The anon key identifies the project; it authorises nothing. `rate_requests`
# has row level security on with no policies, so this key cannot read a single
# enquiry. See supabase/migrations/0001_rate_requests.sql.
#
# Leave them unset and the rate request form falls back to printing the
# composed request instead of pretending to send it.

NEXT_PUBLIC_SUPABASE_URL=https://osswqctfauqcqdlcxjks.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Leave this unset. The site is served from the root of seahivefreight.com, so
# it needs no prefix, and the deploy workflow does not set one.
#
# It exists for the other case: a GitHub Pages *project* site, served from
# /<repo>/ rather than a domain root. Set it only if the site is ever moved
# back to one, and remember it cuts both ways — set when serving from a root,
# every asset 404s; unset when serving from a subdirectory, likewise.
# NEXT_PUBLIC_BASE_PATH=/seahive-freight

# ─────────────────────────────────────────────────────────────────────────────
# NOT here. These are secrets and live only in the Supabase dashboard, under
# Edge Functions → rate-request → Secrets:
#
#   RESEND_API_KEY   sending-only key, scoped to seahivefreight.com
#   MAIL_FROM        Seahive Freight <no-reply@seahivefreight.com>
#   MAIL_REPLY_TO    info@seahivefreight.com
#   SEAHIVE_INBOX    where new queries land; comma-separated for several
# ─────────────────────────────────────────────────────────────────────────────
